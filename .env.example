# Copy to .env and set site-specific values; never commit .env.
AD_LDAP_HOSTS=dc.example.org
AD_LDAP_PORT=636
AD_USE_SSL=true
AD_BIND_USER=reader@example.org
AD_BIND_PASSWORD=REPLACE_ME
AD_DOMAIN_BASE=DC=example,DC=org
AD_PRIMARY_PEOPLE_BASE=OU=People,DC=example,DC=org
AD_SECONDARY_PEOPLE_BASE=OU=PeopleSecondary,DC=example,DC=org
AD_SERVICE_BASE=OU=Service Items,DC=example,DC=org
AD_PAM_BASE=OU=PAM,DC=example,DC=org
AD_TLS_VALIDATE=true
AD_CA_CERT_FILE=/certs/your-ca.pem
AD_CONNECT_TIMEOUT=8
AD_RECEIVE_TIMEOUT=30
AD_DEFAULT_LIMIT=50
AD_MAX_LIMIT=500
AD_EXPORT_MAX_LIMIT=5000
AD_REPORT_MAX_ROWS=100000
AD_REPORT_TTL_SECONDS=900
AD_PUBLIC_BASE_URL=https://ad-mcp.example.org
MCP_TRANSPORT=streamable-http
MCP_HOST=0.0.0.0
MCP_PORT=8000
